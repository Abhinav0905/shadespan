# Copy to .env and fill in from https://yce.perfectcorp.com/api-console (API Keys page).
# Mock mode needs none of this.
SHADESPAN_YOUCAM_API_KEY=
SHADESPAN_YOUCAM_API_SECRET=
# SHADESPAN_YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com

# Measured on a live account 2026-08-16: one cloth render costs 2 units.
# Re-verify any time with `shadespan credit`.
SHADESPAN_UNITS_PER_VTO=2
SHADESPAN_UNITS_PER_ANALYSIS=7
SHADESPAN_MAX_UNITS_PER_RUN=400

# Only needed behind a corporate HTTPS-inspecting proxy. Run `make ca-bundle`.
# SHADESPAN_CA_BUNDLE=ca-bundle.pem
